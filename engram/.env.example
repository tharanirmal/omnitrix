# Copy to .env to override defaults. Everything is local.
ENGRAM_DATABASE_URL=postgresql://engram:engram@127.0.0.1:5433/engram
ENGRAM_OLLAMA_URL=http://127.0.0.1:11434
ENGRAM_EMBED_MODEL=bge-m3
# The person whose brain this is (an Enron mailbox id for the example dataset)
ENGRAM_OWNER=kaminski-v
# the owner's fine-tuned judge, once `engram finetune train` has run (needs `uv sync --extra finetune`)
# ENGRAM_JUDGE_MODEL=mlx:mlx-community/Qwen3-1.7B-bf16@data/adapters/v1
