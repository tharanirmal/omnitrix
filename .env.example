# Copy to .env and adjust. Every value here is local - Omnitrix never calls a cloud AI service.

# Postgres (docker compose service)
OMNITRIX_DATABASE_URL=postgresql://omnitrix:omnitrix@localhost:5432/omnitrix

# Ollama (native on the Mac)
OMNITRIX_OLLAMA_URL=http://localhost:11434
OMNITRIX_MODEL_MAIN=qwen3:14b
OMNITRIX_MODEL_FAST=qwen3:4b
OMNITRIX_MODEL_EMBED=bge-m3
OMNITRIX_EMBED_DIM=1024
# Qwen3 models "think" before answering; off by default for fast structured extraction.
OMNITRIX_LLM_THINK=false
OMNITRIX_LLM_NUM_CTX=16384
# Requests to Ollama run one at a time through a priority queue (one GPU).
OMNITRIX_LLM_CONCURRENCY=1

# Local services
OMNITRIX_MAILPIT_URL=http://localhost:8025
OMNITRIX_NTFY_URL=http://localhost:8080

# Everything is scheduled in this timezone
OMNITRIX_TIMEZONE=Asia/Kolkata
